# Copier ce fichier en secrets.toml (local) ou coller son contenu dans
# "Settings > Secrets" de Streamlit Community Cloud / Hugging Face Spaces.

# Téléchargement automatique des données IEEE-CIS (compte Kaggle + règles de la compétition acceptées)
KAGGLE_USERNAME = "votre_login_kaggle"
KAGGLE_KEY = "votre_cle_api_kaggle"

# Construire automatiquement les artefacts au premier lancement si absents
# AUTO_BUILD = "true"
# MAX_ROWS = "150000"        # limite mémoire sur le cloud (tranche chronologique)

# API déployée séparément (sinon l'API démarre dans le même processus que l'app)
# API_URL = "https://mon-api-fraude.onrender.com"
